    {
      "name": "Limit 3 active books - 4th book rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenLimit}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/borrowings",
        "body": {
          "mode": "raw",
          "raw": "{\"bookId\": \"BK004\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('4th active loan returns 409', () => pm.response.to.have.status(409)); pm.test('Limit code returned', () => pm.expect(pm.response.json().code).to.eql('ACTIVE_LOAN_LIMIT'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unavailable book rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/borrowings",
        "body": {
          "mode": "raw",
          "raw": "{\"bookId\": \"BK001\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unavailable book returns 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
