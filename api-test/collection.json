    },
    {
      "name": "Borrow available book successfully",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/borrowings",
        "body": {
          "mode": "raw",
          "raw": "{\"bookId\": \"BK004\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Borrow returns 201', () => pm.response.to.have.status(201));",
              "const d = pm.response.json().borrowing;",
              "pm.collectionVariables.set('loanId', d.id);",
              "pm.collectionVariables.set('borrowedBookId', d.bookId);",
              "pm.test('Loan status is borrowed', () => pm.expect(d.status).to.eql('borrowed'));",
              "pm.test('Due date is seven days after loan date', () => {",
              "  const a = new Date(d.tanggalPinjam + 'T00:00:00Z');",
              "  const b = new Date(d.batasPengembalian + 'T00:00:00Z');",
              "  pm.expect((b-a)/86400000).to.eql(7);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Return own loan",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}"
          }
        ],
        "url": "{{baseUrl}}/api/borrowings/{{loanId}}/return"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Return returns 200', () => pm.response.to.have.status(200)); pm.test('Loan status returned', () => pm.expect(pm.response.json().borrowing.status).to.eql('returned'));"
            ]
          }
        }
      ]
    },
