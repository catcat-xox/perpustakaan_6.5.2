{
  "info": {
    "name": "Perpustakaan Microservices - UTS (Struktur Asli)",
    "_postman_id": "perpustakaan-microservices-uts-original-structure",
    "description": "Jalankan dari atas ke bawah. Login menyimpan tokenLimit untuk mahasiswa dengan 3 pinjaman aktif dan token untuk mahasiswa uji transaksi. Import database.sql lebih dulu.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenLimit",
      "value": ""
    },
    {
      "key": "loanId",
      "value": ""
    },
    {
      "key": "borrowedBookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health - Books",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/books/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login valid - student 1 (limit test)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"nim\": \"2310001\", \"password\": \"12345\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login success', () => pm.response.to.have.status(200));",
              "const d = pm.response.json(); pm.collectionVariables.set('tokenLimit', d.token);"
            ]
          }
        }
      ]
    },
